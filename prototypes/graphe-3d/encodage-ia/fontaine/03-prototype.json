      "decision": {
        "question": "Pourquoi la chaîne monte-t-elle au-dessus du bécher ?",
        "alternatives": [
          {
            "libelle": "Réaction du tas sur les maillons (α > 0)",
            "retenue": true
          },
          {
            "libelle": "Élan de la chaîne seule (α = 0)",
            "retenue": false,
            "raison": "Le bilan de quantité de mouvement donne alors h₁ = 0."
          },
          {
            "libelle": "Rigidité de flexion de la chaîne",
            "retenue": false,
            "raison": "Aucune force verticale nette au point de prise pour une chaîne souple ; effet de second ordre."
          }

@prefix at: <https://atlas.example/vocab#> .
@prefix : <https://atlas.example/graphe/fontaine/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:graphe a at:Graphe ; at:titre "Fontaine de chaîne (effet Mould)"@fr ; at:resume "Pourquoi une chaîne tirée d’un bécher s’élève au-dessus du bord : réaction du tas au point de prise, h₁/h₂ = α/(1 − α − β). Mesures illustratives."@fr .
:sp_cadre a at:SousProbleme ; at:nom "Cadre et modélisation"@fr ; at:resume "Principes, hypothèses et choix de modélisation de la chaîne."@fr .
:sp_dyn a at:SousProbleme ; at:nom "SP1 · Chaîne en mouvement stationnaire"@fr ; at:resume "Équation du mouvement, tension effective, forme."@fr .
:sp_bords a at:SousProbleme ; at:nom "SP2 · Conditions aux extrémités"@fr ; at:resume "Tension au point de prise (α), à l’arrivée au sol (β), au sommet."@fr .
:sp_pred a at:SousProbleme ; at:nom "SP3 · Prédictions et confrontation"@fr ; at:resume "Loi h₁/h₂, vitesse, estimation de α sur les mesures."@fr .
:sp_billes a at:SousProbleme ; at:nom "Piste abandonnée · élan seul"@fr ; at:resume "Une chaîne sans réaction du tas (α = 0) ne fait pas de fontaine."@fr ; at:abandonne true .
:ax_newton a at:axiome ;
  at:nom "Bilan de quantité de mouvement (système ouvert)"@fr ;
  at:enonce "Sur un volume de contrôle traversé par la chaîne : d𝐩/dt = Σ𝐅_ext + flux entrant de quantité de mouvement − flux sortant."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:admis true ; at:source "Mécanique classique : bilan sur un système ouvert."@fr .
:ax_gravite a at:axiome ;
  at:nom "Pesanteur uniforme"@fr ;
  at:enonce "𝐠 = −g 𝐞_y, g = 9,81 m·s⁻² ; y est l’altitude comptée depuis le haut du tas."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:admis true ; at:source "Mécanique classique."@fr .
:lt_chainette a at:lemme ;
  at:nom "Équilibre d’une chaîne statique"@fr ;
  at:enonce "Une chaîne statique souple sous pesanteur uniforme vérifie T − λ g y = constante ; sa forme est une chaînette."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:utilise :ax_gravite ;
  at:admis true ; at:source "Résultat classique de statique des fils."@fr .
:lt_buckingham a at:lemme ;
  at:nom "Théorème de Vaschy–Buckingham"@fr ;
  at:enonce "Une loi physique s’écrit entre grandeurs sans dimension ; ici h₁/h₂ ne peut dépendre que de α et β."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:admis true ; at:source "Analyse dimensionnelle (Vaschy 1892, Buckingham 1914)."@fr .
:h_inext a at:hypothese ;
  at:nom "Chaîne inextensible"@fr ;
  at:enonce "Maillons de longueur fixe, masse linéique λ uniforme, section négligeable."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain .
:h_stat a at:hypothese ;
  at:nom "Régime stationnaire"@fr ;
  at:enonce "Dans le référentiel du laboratoire, la forme de la fontaine est fixe et la chaîne la parcourt à vitesse constante v."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain .
:h_etroite a at:hypothese ;
  at:nom "Fontaine étroite"@fr ;
  at:enonce "Les deux jambes sont quasi verticales et proches : au sommet, le rayon de courbure est petit devant h₁."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain .
:def_hauteurs a at:definition ;
  at:nom "Hauteurs h₁ et h₂"@fr ;
  at:enonce "h₁ : hauteur du sommet au-dessus du tas ; h₂ : chute du tas jusqu’au sol."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:admis true ; at:source "Biggins et Warner, Proc. R. Soc. A 470 (2014)."@fr .
:def_t_eff a at:definition ;
  at:nom "Tension effective"@fr ;
  at:enonce "T′ = T − λ v² : pour une chaîne en mouvement stationnaire, tension d’une chaîne statique de même forme."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:utilise :h_stat ;
  at:admis true ; at:source "Biggins et Warner, Proc. R. Soc. A 470 (2014)."@fr .
:def_alpha a at:definition ;
  at:nom "Coefficient de prise α"@fr ;
  at:enonce "Fraction de λ v² fournie par la réaction du tas au point de prise : T₀ = (1 − α) λ v²."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:admis true ; at:source "Biggins et Warner, Proc. R. Soc. A 470 (2014)."@fr .
:def_beta a at:definition ;
  at:nom "Coefficient d’arrivée β"@fr ;
  at:enonce "Tension résiduelle au sol : T_s = β λ v² (β = 0 pour un arrêt parfaitement inélastique)."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:admis true ; at:source "Biggins et Warner, Proc. R. Soc. A 470 (2014)."@fr .
:ch_souple a at:choix_modelisation ;
  at:nom "Chaîne parfaitement souple"@fr ;
  at:enonce "Courbe continue sans rigidité de flexion ni de torsion."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:utilise :h_inext ;
  at:choix [ at:hypothese "La chaîne est une courbe continue parfaitement souple."@fr ; at:portee "Équation du mouvement le long de la chaîne (SP1)."@fr ; at:alternative "Maillons rigides articulés discrets"@fr ; at:alternative "Tige élastique avec rigidité de flexion"@fr ] .
:ch_air a at:choix_modelisation ;
  at:nom "Frottement de l’air négligé"@fr ;
  at:enonce "Aucune force aérodynamique sur la chaîne."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:ia ;
  at:choix [ at:hypothese "La traînée de l’air est négligeable devant le poids et les forces de contact."@fr ; at:portee "Tout le bilan de forces (SP1, SP2)."@fr ; at:alternative "Traînée quadratique ∝ ρ_air C_x v²"@fr ] .
:ch_sol a at:choix_modelisation ;
  at:nom "Arrivée au sol paramétrée par β"@fr ;
  at:enonce "Le contact avec le sol est résumé par T_s = β λ v²."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:utilise :def_beta ;
  at:choix [ at:hypothese "Le sol arrête la chaîne en ne lui laissant qu’une tension β λ v²."@fr ; at:portee "Condition au pied de la jambe descendante (SP2)."@fr ; at:alternative "Modèle de choc maillon par maillon"@fr ] .
:obs_mould a at:observation ;
  at:nom "La chaîne monte au-dessus du bécher"@fr ;
  at:enonce "Une chaîne de billes de 50 m tirée par-dessus le bord d’un bécher s’élève au-dessus de celui-ci avant de tomber (Mould, 2013)."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain .
:conj_elan a at:conjecture ;
  at:nom "L’élan de la chaîne suffit"@fr ;
  at:enonce "Sans aucune réaction du tas (α = 0), l’élan acquis par la chaîne suffirait à la faire monter au-dessus du bécher."@fr ;
  at:sousProbleme :sp_billes ;
  at:origine at:ia ;
  at:abandonne true ;
  at:demonstration [ at:nom "Heuristique"@fr ; at:contexte :obs_mould ; at:validite at:invalide ; at:confiance "0.08"^^xsd:decimal ; at:verifiePar at:ia ; prov:wasAttributedTo :directeur_de_labo ] .
:l_mouv a at:lemme ;
  at:nom "Équation du mouvement stationnaire"@fr ;
  at:enonce "∂ₛ(T 𝐭) − λ v² κ 𝐧 + λ𝐠 = 𝟎, où s est l’abscisse curviligne, κ la courbure et 𝐧 la normale."@fr ;
  at:sousProbleme :sp_dyn ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :ax_newton ; at:auxiliaire :ch_souple, :ch_air ; at:contexte :ax_gravite, :h_inext, :h_stat ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:l_effective a at:lemme ;
  at:nom "Réduction à un problème statique"@fr ;
  at:enonce "Avec T′ = T − λ v² : ∂ₛ(T′ 𝐭) + λ𝐠 = 𝟎. La fontaine a la forme d’une chaîne statique de tension T′."@fr ;
  at:sousProbleme :sp_dyn ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :l_mouv ; at:contexte :def_t_eff ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:l_conserv a at:lemme ;
  at:nom "Invariant le long de la chaîne"@fr ;
  at:enonce "T′ − λ g y est constant le long de toute la chaîne, du tas jusqu’au sol."@fr ;
  at:sousProbleme :sp_dyn ;
  at:origine at:ia ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :l_effective ; at:technique :lt_chainette ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :directeur_de_labo ] .
:p_forme a at:proposition ;
  at:nom "Forme : chaînette inversée"@fr ;
  at:enonce "Si les jambes s’écartent, T′ < 0 au sommet : la fontaine prend la forme d’une chaînette inversée (une arche)."@fr ;
  at:sousProbleme :sp_dyn ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :l_effective ; at:technique :lt_chainette ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:p_billes a at:proposition ;
  at:nom "Avec α = 0, pas de fontaine"@fr ;
  at:enonce "Si le tas n’exerce aucune réaction, T′₀ = 0 et l’invariant impose h₁ = 0 : la chaîne ne dépasse pas le bord."@fr ;
  at:sousProbleme :sp_billes ;
  at:origine at:humain ;
  at:abandonne true ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :conj_elan, :l_conserv ; at:contexte :def_alpha ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:d_origine a at:decision ;
  at:nom "Origine de la fontaine"@fr ;
  at:enonce "Quelle force fournit la quantité de mouvement verticale au point de prise ?"@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:ia ;
  at:decision [ at:question "Pourquoi la chaîne monte-t-elle au-dessus du bécher ?"@fr ; at:alternative [ at:libelle "Réaction du tas sur les maillons (α > 0)"@fr ; at:retenue true ] , [ at:libelle "Élan de la chaîne seule (α = 0)"@fr ; at:retenue false ; at:raison "Le bilan de quantité de mouvement donne alors h₁ = 0."@fr ] , [ at:libelle "Rigidité de flexion de la chaîne"@fr ; at:retenue false ; at:raison "Aucune force verticale nette au point de prise pour une chaîne souple ; effet de second ordre."@fr ] ; at:raison "Seule une force extérieure au point de prise peut fournir la quantité de mouvement verticale manquante."@fr ] ;
  at:demonstration [ at:nom "Délibération"@fr ; at:principale :obs_mould, :p_billes ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :directeur_de_labo ] .
:ch_prise a at:choix_modelisation ;
  at:nom "Force de prise anormale"@fr ;
  at:enonce "Le tas pousse les maillons vers le haut au moment où ils sont mis en mouvement."@fr ;
  at:sousProbleme :sp_cadre ;
  at:origine at:humain ;
  at:choix [ at:hypothese "Au point de prise, le tas exerce sur la chaîne une réaction verticale : T₀ = (1 − α) λ v², α > 0."@fr ; at:portee "Condition au point de prise, puis toutes les prédictions (SP2, SP3)."@fr ; at:alternative "α = 0 : prise classique sans réaction"@fr ; at:alternative "Modèle microscopique explicite des maillons"@fr ] ;
  at:demonstration [ at:nom "Justification du choix"@fr ; at:principale :d_origine ; at:contexte :def_alpha ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:l_prise a at:lemme ;
  at:nom "Tension au point de prise"@fr ;
  at:enonce "Bilan de quantité de mouvement sur le point de prise : T₀ = (1 − α) λ v², soit T′₀ = −α λ v²."@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :ax_newton ; at:auxiliaire :ch_prise ; at:contexte :def_alpha ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:l_sol a at:lemme ;
  at:nom "Tension à l’arrivée au sol"@fr ;
  at:enonce "Au pied de la jambe descendante : T_s = β λ v², soit T′_s = −(1 − β) λ v²."@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:ia ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :ax_newton ; at:auxiliaire :ch_sol ; at:contexte :def_beta ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :directeur_de_labo ] .
:l_sommet a at:lemme ;
  at:nom "Condition au sommet"@fr ;
  at:enonce "Pour une fontaine étroite, l’arche du sommet porte une tension effective négligeable : T′ ≈ 0 en y = h₁."@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :l_effective ; at:contexte :h_etroite, :def_hauteurs ; at:validite at:a_verifier ; prov:wasAttributedTo :camille ] .
:d_alpha a at:decision ;
  at:nom "Estimer α"@fr ;
  at:enonce "Comment estimer le coefficient de prise α ?"@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:humain ;
  at:decision [ at:question "Comment estimer α indépendamment de la hauteur de la fontaine ?"@fr ; at:alternative [ at:libelle "Simulation de maillons rigides soulevés depuis un tas"@fr ; at:retenue true ] , [ at:libelle "Capteur de force sous le bécher"@fr ; at:retenue false ; at:raison "Force de prise trop brève et trop faible pour le capteur disponible."@fr ] , [ at:libelle "Ajustement sur h₁/h₂ seulement"@fr ; at:retenue false ; at:raison "Circulaire : on veut tester la loi, pas l’ajuster."@fr ] ; at:raison "La simulation donne α sans utiliser la hauteur mesurée, ce qui permet une vraie confrontation."@fr ] ;
  at:demonstration [ at:nom "Délibération"@fr ; at:principale :ch_prise ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:calc_tiges a at:calcul ;
  at:nom "Simulation de maillons rigides"@fr ;
  at:enonce "Dynamique de 2 000 tiges rigides articulées tirées depuis un tas désordonné : α ≈ 0,10 ± 0,04 (valeur illustrative)."@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:ordinateur ;
  at:demonstration [ at:nom "Script"@fr ; at:principale :d_alpha, :ax_newton ; at:contexte :ch_prise ; at:validite at:a_verifier ; prov:wasAttributedTo :experimentateur ] .
:exp_sol a at:experience ;
  at:nom "Arrivée sur sol dur ou sur mousse"@fr ;
  at:enonce "Vitesse v mesurée pour deux surfaces d’arrivée, à h₂ fixé."@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Protocole"@fr ; at:contexte :ch_sol ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:obs_beta a at:observation ;
  at:nom "β faible"@fr ;
  at:enonce "β ≈ 0,1 sur sol dur, ≈ 0 sur mousse (valeurs illustratives)."@fr ;
  at:sousProbleme :sp_bords ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Mesure"@fr ; at:principale :exp_sol ; at:auxiliaire :l_sol ; at:validite at:a_verifier ; prov:wasAttributedTo :camille ] .
:p_vitesse a at:proposition ;
  at:nom "Vitesse de la chaîne"@fr ;
  at:enonce "En égalant l’invariant au point de prise et au sol : v² = g h₂ / (1 − α − β)."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:ia ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :l_conserv, :l_prise, :l_sol ; at:contexte :def_hauteurs ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :directeur_de_labo ] .
:p_hauteur a at:proposition ;
  at:nom "Hauteur de la fontaine"@fr ;
  at:enonce "En égalant l’invariant au point de prise et au sommet : α v² = g h₁."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :l_conserv, :l_prise, :l_sommet ; at:contexte :def_hauteurs ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:thm_rapport a at:theoreme ;
  at:nom "Loi de la fontaine"@fr ;
  at:enonce "h₁ / h₂ = α / (1 − α − β) : la hauteur de la fontaine est proportionnelle à la hauteur de chute."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :p_vitesse, :p_hauteur ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:calc_dim a at:calcul ;
  at:nom "Contrôles de cohérence"@fr ;
  at:enonce "Loi sans dimension ; α → 0 donne h₁ → 0 (piste abandonnée) ; α + β → 1 fait diverger v (plus de freinage)."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:ia ;
  at:demonstration [ at:nom "Script"@fr ; at:principale :thm_rapport ; at:technique :lt_buckingham ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :directeur_de_labo ] .
:exp_film a at:experience ;
  at:nom "Films à haute vitesse"@fr ;
  at:enonce "Chaîne à billes de 50 m, h₂ de 0,5 à 2 m ; h₁ et v relevés image par image (illustratif)."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Protocole"@fr ; at:contexte :def_hauteurs ; at:validite at:valide ; at:confiance "0.91"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:obs_lineaire a at:observation ;
  at:nom "h₁ proportionnelle à h₂"@fr ;
  at:enonce "h₁ / h₂ = 0,13 ± 0,03 sur toute la gamme de h₂ (valeurs illustratives)."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Mesure"@fr ; at:principale :exp_film ; at:validite at:valide ; at:confiance "0.8"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:obs_v a at:observation ;
  at:nom "v² proportionnelle à h₂"@fr ;
  at:enonce "Pente de v² contre h₂ : 11,4 ± 0,6 m·s⁻², soit 1 − α − β ≈ 0,86 (valeurs illustratives)."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:ia ;
  at:demonstration [ at:nom "Mesure"@fr ; at:principale :exp_film ; at:validite at:valide ; at:confiance "0.78"^^xsd:decimal ; at:verifiePar at:humain ; prov:wasAttributedTo :directeur_de_labo ] .
:res_alpha a at:resultat ;
  at:nom "Estimation de α"@fr ;
  at:enonce "Les mesures donnent α ≈ 0,11 ± 0,03, compatible avec la simulation de maillons (α ≈ 0,10 ± 0,04)."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :thm_rapport, :obs_lineaire, :obs_v ; at:auxiliaire :obs_beta, :calc_tiges ; at:validite at:a_verifier ; prov:wasAttributedTo :camille ] .
:res_explication a at:resultat ;
  at:nom "La fontaine vient de la réaction du tas"@fr ;
  at:enonce "Une réaction verticale du tas sur les maillons au point de prise (α ≈ 0,1) explique à la fois la hauteur et la vitesse observées."@fr ;
  at:sousProbleme :sp_pred ;
  at:origine at:humain ;
  at:demonstration [ at:nom "Démonstration"@fr ; at:principale :res_alpha, :thm_rapport, :calc_dim ; at:contexte :d_origine, :p_forme ; at:validite at:valide ; at:confiance "0.82"^^xsd:decimal ; at:verifiePar at:ia ; at:verifiePar at:humain ; prov:wasAttributedTo :camille ] .
:p_billes at:contredit :obs_mould .  # La fontaine est pourtant observée.
:d_origine at:abandonne :conj_elan .

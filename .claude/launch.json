{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api.index:app", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "voix-back",
      "runtimeExecutable": "AtlasVoice/backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "AtlasVoice/backend",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "voix-front",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "AtlasVoice/frontend",
        "run",
        "dev"
      ],
      "port": 5174
    }
  ]
}

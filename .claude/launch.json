{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "atlas.serveur:app", "--port", "8000",
        "--reload", "--reload-dir", "atlas", "--reload-dir", "api"
      ],
      "port": 8000
    }
  ]
}

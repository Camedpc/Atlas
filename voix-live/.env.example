# Clé Gradium (studio.gradium.ai → Clés API)
GRADIUM_API_KEY=

# Serveurs Gradium (UE par défaut)
# VOIX_GRADIUM_WSS=wss://eu.api.gradium.ai

# Transcription
# VOIX_STT_LANGUE=fr
# VOIX_STT_DELAI=10                 # trames de 80 ms : plus haut = plus fiable, plus lent en fin de tour
# VOIX_STT_TEMPERATURE=
# VOIX_STT_BOOST=3
# VOIX_MOTS_CLES=Atlas,Codex,Camille,Gradium,Supabase,graphe

# Tours de parole (VAD sémantique)
# VOIX_FIN_TOUR_HORIZON=2           # 0 = 0,5 s, 1 = 1 s, 2 = 2 s, 3 = 3 s
# VOIX_FIN_TOUR_SEUIL=0.6
# VOIX_FIN_TOUR_PAS=3
# VOIX_COUPURE_SEUIL=0.35
# VOIX_COUPURE_PAS=4

# Synthèse
# VOIX_VOIX=iEu63s1rhn_kegTr        # Gaspard
# VOIX_TTS_MODELE=default
# VOIX_TTS_VITESSE=-0.5             # padding_bonus : négatif = plus rapide

# Cerveau (Codex)
# VOIX_CODEX_HOME=../espace/.codex
# VOIX_MODELE=gpt-5.6-luna
# VOIX_EFFORT=low
# VOIX_TIER=fast                    # plus rapide, consomme plus de quota ; vide = normal
# VOIX_MODELE_TACHES=gpt-6-sol
# VOIX_EFFORT_TACHES=medium
# VOIX_DOSSIER_TRAVAIL=..           # dossier courant des commandes

# VOIX_PORT=8010

# Copier en .env à la racine pour le dev local. Sur Vercel : Settings → Environment Variables.
# Lues uniquement par l'API Python (jamais envoyées au navigateur).
SUPABASE_URL=https://uykaupigovrvgwsckbcn.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Local seulement, pour `npm run db:push` (Supabase → Project Settings → Database → Database password).
SUPABASE_DB_PASSWORD=

# ── Orchestrateur (serveur longue durée : uvicorn atlas.serveur:app) ──
# Clé API OpenAI. Vide = compte ChatGPT connecté avec `python -m atlas.orchestrateur.connexion` (dev).
# Renseignée, elle est prioritaire et remplace la connexion ChatGPT au tour suivant.
OPENAI_API_KEY=
# Vide = modèle par défaut de Codex.
ATLAS_MODELE_ORCHESTRATEUR=
# none | minimal | low | medium | high | xhigh | max
ATLAS_EFFORT_ORCHESTRATEUR=high
# Dossier de travail de l'agent (un sous-dossier par conversation). Vide = ./espace
ATLAS_ESPACE_TRAVAIL=
# Bunker des agents (atlas/orchestrateur/bunker.py) : session = dossier espace/utilisateurs/<utilisateur>/<projet>/
# sessions/<conversation>. ATLAS_BUNKER=1 : le sandbox de Codex confine leurs écritures à la session. Sur la VM :
# ATLAS_BUNKER=0 (le sandbox Linux de Codex ne peut pas démarrer dans Docker) ; seule la consigne les confine.
ATLAS_BUNKER=1
ATLAS_UTILISATEUR=camille
ATLAS_PROJET=defaut
# Dossier Codex propre à Atlas (connexion, threads). Vide = <espace de travail>/.codex. Jamais ~/.codex.
ATLAS_CODEX_HOME=
# Exécutable Codex. Vide = celui installé avec le SDK.
ATLAS_CODEX_BIN=
# Nombre maximal de sous-agents ouverts en même temps par conversation (Codex ajoute une place pour
# l'orchestrateur). Vide = réglage par défaut de Codex (3).
ATLAS_MAX_SOUS_AGENTS=10
# Le processus Codex reste ouvert entre les tours ; un thread inutilisé (et ses sous-agents) y reste chargé tant
# de secondes, pour répondre sans le recharger. Vide = 3600.
ATLAS_DUREE_THREAD_CHAUD=
# Modèle et effort de chaque sous-agent (prompts : atlas/orchestrateur/prompts/). Vide = valeur par défaut :
# directeur_de_labo gpt-6-astra/high, litterature gpt-6-luna/medium, experimentateur gpt-6-sol/high,
# graphiste gpt-6-sol/medium.
ATLAS_MODELE_DIRECTEUR_DE_LABO=
ATLAS_EFFORT_DIRECTEUR_DE_LABO=
ATLAS_MODELE_LITTERATURE=
ATLAS_EFFORT_LITTERATURE=
ATLAS_MODELE_EXPERIMENTATEUR=
ATLAS_EFFORT_EXPERIMENTATEUR=
ATLAS_MODELE_GRAPHISTE=
ATLAS_EFFORT_GRAPHISTE=
# Vérificateur : le modèle économique (défaut gpt-6-luna/high) juge chaque démonstration ; si le verdict est
# « invalide » ou sous ATLAS_SEUIL_CONFIANCE, le modèle de recours (défaut gpt-6-sol/high) rejuge et fait foi.
ATLAS_MODELE_VERIFICATEUR=
ATLAS_EFFORT_VERIFICATEUR=
ATLAS_MODELE_VERIFICATEUR_RECOURS=
ATLAS_EFFORT_VERIFICATEUR_RECOURS=
ATLAS_SEUIL_CONFIANCE=0.8
# Démonstrations jugées en même temps, et durée maximale d'un appel à `verifier` en secondes.
ATLAS_MAX_VERIFICATIONS=6
ATLAS_DELAI_VERIFICATION=1800
# Origines navigateur autorisées (front hébergé ailleurs que le serveur), séparées par des virgules.
# Sur la VM : https://atlas-nine-bay.vercel.app
ATLAS_CORS_ORIGINES=
# Jeton exigé sur les routes des conversations. Vide = pas de contrôle (dev local uniquement).
# Obligatoire sur la VM : openssl rand -hex 32
ATLAS_JETON_ACCES=
# VM seulement : adresse publique servie en HTTPS par Caddy, ex. 203-0-113-7.sslip.io
ATLAS_DOMAINE=

# ── Voix : Atlas voix, appel vocal en direct (atlas/voix) ──
# Clé Gradium (studio.gradium.ai → Clés API). Sans elle, le bouton micro refuse l'appel.
# L'offre gratuite permet 3 sessions Gradium simultanées : un seul appel à la fois.
GRADIUM_API_KEY=
# Modèle et effort d'Atlas voix (défaut gpt-6-sol/low) et de ses petites tâches (défaut gpt-6-luna/medium).
ATLAS_MODELE_VOIX=
ATLAS_EFFORT_VOIX=
ATLAS_MODELE_TACHE_VOCALE=
ATLAS_EFFORT_TACHE_VOCALE=
# Niveau de service Codex de la voix : fast (défaut, ≈ 0,9 s au premier mot, plus de quota) ; vide = normal.
ATLAS_VOIX_TIER=fast
# Voix Gradium (défaut Gaspard), vitesse (padding_bonus, négatif = plus rapide), langue de la transcription.
ATLAS_VOIX_VOIX=
ATLAS_VOIX_TTS_VITESSE=
ATLAS_VOIX_LANGUE=fr
# Transcription : délai en trames de 80 ms (10 ≈ 0,35 à 0,7 s après la fin de la phrase) et mots boostés.
ATLAS_VOIX_STT_DELAI=10
# Gradium coupe une session de transcription à 300 s (offre gratuite) : renouvelée au premier silence après
# ATLAS_VOIX_STT_DUREE secondes, et d'office après ATLAS_VOIX_STT_DUREE_FORCEE (le micro n'est pas perdu).
ATLAS_VOIX_STT_DUREE=240
ATLAS_VOIX_STT_DUREE_FORCEE=285
ATLAS_VOIX_MOTS_CLES=
# Tours de parole (VAD sémantique de Gradium) : fin de tour et coupure de la voix quand Camille parle.
ATLAS_VOIX_FIN_TOUR_HORIZON=2
ATLAS_VOIX_FIN_TOUR_SEUIL=0.6
ATLAS_VOIX_FIN_TOUR_PAS=3
ATLAS_VOIX_COUPURE_SEUIL=0.35
ATLAS_VOIX_COUPURE_PAS=4
# Messages de la conversation donnés à la voix au décroché.
ATLAS_VOIX_CONTEXTE_MESSAGES=30
# Atlas voix préparé à l'avance dès qu'une conversation s'ouvre (un processus Codex et un tour d'échauffement), gardé
# prêt ce nombre de secondes : l'appel démarre alors presque tout de suite. 0 = préparation au clic (6 à 7 s).
ATLAS_VOIX_PRECHAUFFAGE_S=600
# Diagnostic : 1 = enregistre le micro reçu et les tours transcrits dans le .tmp de la session.
ATLAS_VOIX_ENREGISTRER=
# Adresse à laquelle les serveurs MCP (voix, vérificateur) rappellent atlas.serveur (même machine ou conteneur).
ATLAS_URL_INTERNE=http://127.0.0.1:8000

# Copier en .env à la racine pour le dev local. Sur Vercel : Settings → Environment Variables.
# Lues uniquement par l'API Python (jamais envoyées au navigateur).
SUPABASE_URL=https://uykaupigovrvgwsckbcn.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Local seulement, pour `npm run db:push` (Supabase → Project Settings → Database → Database password).
SUPABASE_DB_PASSWORD=

# ── Orchestrateur (serveur longue durée : uvicorn atlas.serveur:app) ──
# Clé API OpenAI. Vide = compte ChatGPT connecté avec `python -m atlas.orchestrateur.connexion` (dev).
# Renseignée, elle est prioritaire et remplace la connexion ChatGPT au tour suivant.
OPENAI_API_KEY=
# Vide = modèle par défaut de Codex.
ATLAS_MODELE_ORCHESTRATEUR=
# none | minimal | low | medium | high | xhigh | max
ATLAS_EFFORT_ORCHESTRATEUR=high
# Dossier de travail de l'agent (un sous-dossier par conversation). Vide = ./espace
ATLAS_ESPACE_TRAVAIL=
# Dossier Codex propre à Atlas (connexion, threads). Vide = <espace de travail>/.codex. Jamais ~/.codex.
ATLAS_CODEX_HOME=
# Exécutable Codex. Vide = celui installé avec le SDK.
ATLAS_CODEX_BIN=
# Nombre maximal de sous-agents ouverts en même temps par conversation (Codex ajoute une place pour
# l'orchestrateur). Vide = réglage par défaut de Codex (3).
ATLAS_MAX_SOUS_AGENTS=10
# Modèle et effort de chaque sous-agent (prompts : atlas/orchestrateur/prompts/). Vide = valeur par défaut :
# directeur_de_labo gpt-6-astra/high, litterature gpt-6-luna/medium, experimentateur gpt-6-sol/high,
# graphiste gpt-6-sol/medium.
ATLAS_MODELE_DIRECTEUR_DE_LABO=
ATLAS_EFFORT_DIRECTEUR_DE_LABO=
ATLAS_MODELE_LITTERATURE=
ATLAS_EFFORT_LITTERATURE=
ATLAS_MODELE_EXPERIMENTATEUR=
ATLAS_EFFORT_EXPERIMENTATEUR=
ATLAS_MODELE_GRAPHISTE=
ATLAS_EFFORT_GRAPHISTE=
# Vérificateur : le modèle économique (défaut gpt-6-luna/high) juge chaque démonstration ; si le verdict est
# « invalide » ou sous ATLAS_SEUIL_CONFIANCE, le modèle de recours (défaut gpt-6-sol/high) rejuge et fait foi.
ATLAS_MODELE_VERIFICATEUR=
ATLAS_EFFORT_VERIFICATEUR=
ATLAS_MODELE_VERIFICATEUR_RECOURS=
ATLAS_EFFORT_VERIFICATEUR_RECOURS=
ATLAS_SEUIL_CONFIANCE=0.8
# Démonstrations jugées en même temps, et durée maximale d'un appel à `verifier` en secondes.
ATLAS_MAX_VERIFICATIONS=6
ATLAS_DELAI_VERIFICATION=1800
# Origines navigateur autorisées (front hébergé ailleurs que le serveur), séparées par des virgules.
# Sur la VM : https://atlas-nine-bay.vercel.app
ATLAS_CORS_ORIGINES=
# Jeton exigé sur les routes des conversations. Vide = pas de contrôle (dev local uniquement).
# Obligatoire sur la VM : openssl rand -hex 32
ATLAS_JETON_ACCES=
# VM seulement : adresse publique servie en HTTPS par Caddy, ex. 203-0-113-7.sslip.io
ATLAS_DOMAINE=

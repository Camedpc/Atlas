# Copier en .env à la racine pour le dev local. Sur Vercel : Settings → Environment Variables.
# Lues uniquement par l'API Python (jamais envoyées au navigateur).
SUPABASE_URL=https://uykaupigovrvgwsckbcn.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Local seulement, pour `npm run db:push` (Supabase → Project Settings → Database → Database password).
SUPABASE_DB_PASSWORD=

# ── Orchestrateur (serveur longue durée : uvicorn atlas.serveur:app) ──
# Clé API OpenAI. Vide = compte ChatGPT connecté avec `python -m atlas.orchestrateur.connexion` (dev).
# Renseignée, elle est prioritaire et remplace la connexion ChatGPT au tour suivant.
OPENAI_API_KEY=
# Vide = modèle par défaut de Codex.
ATLAS_MODELE_ORCHESTRATEUR=
# none | minimal | low | medium | high | xhigh | max
ATLAS_EFFORT_ORCHESTRATEUR=high
# Dossier de travail de l'agent (un sous-dossier par conversation). Vide = ./espace
ATLAS_ESPACE_TRAVAIL=
# Dossier Codex propre à Atlas (connexion, threads). Vide = <espace de travail>/.codex. Jamais ~/.codex.
ATLAS_CODEX_HOME=
# Exécutable Codex. Vide = celui installé avec le SDK.
ATLAS_CODEX_BIN=
# Origines navigateur autorisées (front hébergé ailleurs que le serveur), séparées par des virgules.
ATLAS_CORS_ORIGINES=

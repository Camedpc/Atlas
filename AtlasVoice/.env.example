# ── Couche vocale ───────────────────────────────────────────────
GRADIUM_API_KEY=gd_...
# Endpoint UE de Gradium (traitement en UE garanti avec l'option « data residency »)
GRADIUM_BASE_URL=https://eu.api.gradium.ai/api/
# Voix française du catalogue (Damien). Liste : python -c "import gradbot; print(gradbot.flagship_voices())"
ATLAS_VOICE_ID=25AzBFyp6svYnJsj
# Vitesse : -4 (plus rapide) à 4 (plus lent), 0 par défaut
ATLAS_TTS_PADDING_BONUS=0
# Température : 0 (plus stable) à 1,4 (plus variée) ; vide = défaut Gradium (0,7)
# ATLAS_TTS_TEMP=0.7

# ── Modèle d'Atlas (rapide, sans raisonnement) ──────────────────
# fournisseur : anthropic (SDK officiel) ou openai (toute API compatible OpenAI)
ATLAS_LLM_FOURNISSEUR=anthropic
ATLAS_LLM_MODELE=claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-...
# Secours si le premier token dépasse 1,5 s ou en cas d'erreur (facultatif)
# ATLAS_LLM_SECOURS_FOURNISSEUR=openai
# ATLAS_LLM_SECOURS_MODELE=gpt-4.1-mini
# ATLAS_LLM_SECOURS_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# Champs ajoutés à chaque requête, ex. pour couper le raisonnement : {"reasoning_effort": "none"}
# ATLAS_LLM_EXTRA={}

# Adresse à laquelle Gradbot joint le proxy LLM du back (le back lui-même ; à changer si le port diffère)
# ATLAS_URL_INTERNE=http://127.0.0.1:8001

# ── Registre des tâches ─────────────────────────────────────────
# Connexion Postgres directe (Supabase : Session pooler ou connexion directe, pour LISTEN/NOTIFY).
# Sans cette variable, le registre vit en mémoire.
# DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── Sécurité ────────────────────────────────────────────────────
# JWT secret du projet Supabase : si défini, chaque session exige un utilisateur connecté.
# SUPABASE_JWT_SECRET=
# Clé partagée par les agents (en-tête X-Agents-Cle)
AGENTS_API_KEY=change-moi
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Observabilité ───────────────────────────────────────────────
# Jours de conservation des transcriptions (0 = aucune transcription conservée)
ATLAS_RETENTION_JOURS=30
